# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=3000

# Connect GitHub (profile → Connections). Any long random string; it seals the
# OAuth token at rest with AES-256-GCM. Unset = the feature reports disabled and
# public repo import in Studio keeps working untouched.
GITHUB_TOKEN_KEY=

# Mail (HTTPS only — Render seals SMTP ports). First configured sender wins:
# Gmail API (primary, free, no domain needed — Cloud project "Cudic Mail")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=nathen.t2023@gmail.com
# Resend (fallback; unverified domains only reach the account inbox)
RESEND_API_KEY=
# Brevo API (fallback; needs a verified sender, never configured)
BREVO_API_KEY=
BREVO_SENDER=
# Composio MCP gateway (https://connect.composio.dev/mcp) — consumer key, ck_...
COMPOSIO_API_KEY=


# Discord — channel webhooks in the Cudic server (Server Settings → Integrations).
# Unset means nothing is posted and nothing else changes.
# #announcements: one embed, on a game's first publish (draft → published).
DISCORD_WEBHOOK_GAMES=
# #website-status: posted by tools/discord-status.mjs when the site changes state.
DISCORD_WEBHOOK_STATUS=
# #updates: posted by tools/discord-update.mjs on every push to main.
DISCORD_WEBHOOK_UPDATES=

# Render API key (dashboard → Account Settings → API Keys). Only used for
# read-only ownership and deploy checks; server.js never reads it.
RENDER_API_KEY=

# Cloudflare Turnstile — bot gate on signup codes, signup confirm, password
# reset and account deletion. Both unset = no gate at all, which is how a
# fresh clone runs. The site key is public (/api/turnstile); the secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
