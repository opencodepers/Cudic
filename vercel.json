{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/welcome", "destination": "/welcome.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/games", "destination": "/games.html" },
    { "source": "/arcade", "destination": "https://glox-o7rr.onrender.com/arcade" },
    { "source": "/daily", "destination": "https://glox-o7rr.onrender.com/daily" },
    { "source": "/five", "destination": "https://glox-o7rr.onrender.com/five" },
    { "source": "/forums", "destination": "/forums.html" },
    { "source": "/forums/:id", "destination": "/forums.html" },
    { "source": "/kit", "destination": "/kit.html" },
    { "source": "/themes", "destination": "/themes.html" },
    { "source": "/quests", "destination": "/quests.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/race", "destination": "/race.html" },
    { "source": "/creator", "destination": "/creator.html" },
    { "source": "/friends", "destination": "/friends.html" },
    { "source": "/notifications", "destination": "/notifications.html" },
    { "source": "/ops", "destination": "/ops.html" },
    { "source": "/collections", "destination": "/collections.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/parents", "destination": "/parents.html" },
    { "source": "/teachers", "destination": "/parents.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/accessibility", "destination": "/accessibility.html" },
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/view", "destination": "/view.html" },
    { "source": "/editor", "destination": "/editor.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/servers", "destination": "/servers.html" },
    { "source": "/server", "destination": "/server.html" },
    { "source": "/server/:id", "destination": "/server.html" },
    { "source": "/moderate", "destination": "/moderate.html" },
{ "source": "/grant", "destination": "/grant.html" },
{ "source": "/updlog", "destination": "/updlog.html" },
    { "source": "/updlog.xml", "destination": "https://glox-o7rr.onrender.com/updlog.xml" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/g/:id/thumb", "destination": "https://glox-o7rr.onrender.com/g/:id/thumb" },
    { "source": "/g/:id", "destination": "https://glox-o7rr.onrender.com/g/:id" }
  ],
  "redirects": [
    { "source": "/lobbies", "destination": "/chat", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri https://glox-o7rr.onrender.com/api/csp-report"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/studio/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "buildCommand": "cd studio && npm ci && npm run build && cd .. && node tools/prerender-games.mjs",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": null
}
